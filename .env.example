# Export these in your shell. Bun also loads a local .env during development.
CLOCKIFY_API_KEY=""
CLOCKIFY_USER_ID=""
CLOCKIFY_WORKSPACE_ID=""

# Zoho People OAuth credentials, not your Zoho login password.
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
# Optional overrides. First-run setup obtains and saves these automatically.
# ZOHO_REFRESH_TOKEN=""
# Employee record ID (ERECNO), not an employee display number or email.
# ZOHO_EMPLOYEE_ID=""
# Your Zoho data center, for example com, in, or eu.
# ZOHO_REGION="com"

# Optional IANA timezone. Defaults to the local system timezone.
# SYNCZC_TIMEZONE=Europe/London
# Optional private state directory. Defaults to your OS application-data directory.
# SYNCZC_STATE_DIR=
# If Zoho returns company-formatted dates instead of ISO, specify their order.
# ZOHO_DATE_FORMAT=dd-MM-yyyy
