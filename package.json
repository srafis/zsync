{
	"name": "@srafis/zsync",
	"type": "module",
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "^22.20.2",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@clack/core": "1.5.0",
		"@clack/prompts": "^1.8.0",
		"@js-temporal/polyfill": "^0.5.1",
		"fast-string-width": "3.0.2"
	},
	"version": "0.1.18",
	"description": "Interactively sync Clockify entries to Zoho People",
	"bin": {
		"zsync": "dist/zsync.js"
	},
