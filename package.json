		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"prepack": "bun run build"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/srafis/zoho-clockify-sync.git"
